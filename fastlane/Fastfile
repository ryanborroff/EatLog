default_platform(:ios)

platform :ios do
  desc "Build a release .ipa and upload it to TestFlight"
  lane :beta do
    # Regenerate the native project from app.json/plugins before building,
    # same as EAS does — keeps this lane in sync without a second source of truth.
    sh("cd .. && npx expo prebuild -p ios")
    cocoapods(podfile: "ios/Podfile")

    # Prebuild regenerates the project from scratch, so take the next number
    # from TestFlight rather than bumping whatever the fresh project starts at.
    api_key = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] ? app_store_connect_api_key : nil
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "com.ryanfborroff.EatLog")
    increment_build_number(xcodeproj: "ios/EatLog.xcodeproj", build_number: latest + 1)

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: "SWVSGRAP86",
      path: "ios/EatLog.xcodeproj"
    )

    build_app(
      workspace: "ios/EatLog.xcworkspace",
      scheme: "EatLog",
      export_method: "app-store",
      configuration: "Release",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "SWVSGRAP86"
      },
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      # Prefers an App Store Connect API key to avoid the Apple-ID 2FA prompt.
      # With no arguments, app_store_connect_api_key reads fastlane's standard
      # APP_STORE_CONNECT_API_KEY_KEY_ID / _ISSUER_ID / _KEY (raw .p8 contents)
      # env vars, as exported in ~/.zshrc. Falls back to Apple ID login
      # (FASTLANE_USER + app-specific password) if they aren't set.
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
